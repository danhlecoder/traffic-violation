# Server Configuration
LOG_LEVEL=INFO


# Stream Settings
STREAM_DEFAULT_FPS=15
STREAM_DEFAULT_QUALITY=70
STREAM_RECONNECT_TIMEOUT=5
STREAM_SKIP_FRAMES=2
STREAM_DETECTION_WIDTH=640

# === YOLO Detection Parameters ===
# Ngưỡng confidence tối thiểu (0.0-1.0)
YOLO_CONFIDENCE=0.25

# Ngưỡng IOU cho NMS (0.0-1.0)
YOLO_IOU_THRESHOLD=0.45

# Số detection tối đa trên 1 frame
YOLO_MAX_DETECTIONS=100

# === Stream Parameters ===
# FPS output stream
STREAM_DEFAULT_FPS=15

# Chất lượng JPEG (10-95)
STREAM_DEFAULT_QUALITY=70

# Timeout reconnect (giây)
STREAM_RECONNECT_TIMEOUT=5

# Số frame skip
STREAM_SKIP_FRAMES=2

# Chiều rộng resize trước detect (pixel)
STREAM_DETECTION_WIDTH=640

# === Detection Display ===
# Độ dày bounding box - số nguyên (pixel)
BBOX_THICKNESS=1

# Kích thước font label (0.1-2.0)
FONT_SCALE=0.1

# Độ dày font - số nguyên
FONT_THICKNESS=1

# === Vehicle Density Thresholds ===
# Ngưỡng "Thưa" (số xe)
DENSITY_THRESHOLD_LOW=5

# Ngưỡng "Đông" (số xe)
DENSITY_THRESHOLD_MEDIUM=15

# === Vision - Stop Line Detection ===
# Canny low threshold
VISION_CANNY_LOW=30

# Canny high threshold
VISION_CANNY_HIGH=30

# Hough threshold
VISION_HOUGH_THRESHOLD=100

# Min line length factor (0.0-1.0)
VISION_MIN_LINE_LEN_FACTOR=0.25

# Max gap factor (0.0-1.0)
VISION_MAX_GAP_FACTOR=0.02

# Min line length (pixel)
VISION_MIN_LINE_LEN_MIN_PX=60

# Max gap (pixel)
VISION_MAX_GAP_MIN_PX=10

# Angle max (độ)
VISION_ANGLE_MAX_DEG=10

# Center bias ratio (0.0-1.0)
VISION_CENTER_BIAS_RATIO=0.35

# Bottom min Y ratio (0.0-1.0)
VISION_BOTTOM_MIN_Y_RATIO=0.6

