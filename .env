# ===================== SERVER =====================
LOG_LEVEL=INFO                     # Mức log: TRACE|DEBUG|INFO|WARN|ERROR

# ===================== YOLO (DETECTION) =====================
YOLO_CONFIDENCE=0.25               # Ngưỡng confidence (0.0–1.0)
YOLO_IOU_THRESHOLD=0.45            # Ngưỡng IOU cho NMS (0.0–1.0)
YOLO_MAX_DETECTIONS=100            # Số detection tối đa / frame

# ===================== STREAM (GIẢM LAG) =====================
STREAM_DEFAULT_FPS=60              # FPS đầu ra (giảm để mượt)
STREAM_DEFAULT_QUALITY=90          # Chất lượng JPEG (95-100: cao nhất)
STREAM_RECONNECT_TIMEOUT=5         # Timeout reconnect (giây)
STREAM_SKIP_FRAMES=1               # Bỏ qua N frame / lần detect (1=detect mọi frame)
STREAM_DETECTION_WIDTH=0           # 0 = Không resize, dùng ảnh gốc (để detect đèn nhỏ)

# ===================== HIỂN THỊ DETECTION =====================
BBOX_THICKNESS=1                   # Độ dày khung (px)
FONT_SCALE=0.5                     # Tỉ lệ font (0.1–2.0)
FONT_THICKNESS=1                   # Độ dày chữ (px)

# ===================== MẬT ĐỘ PHƯƠNG TIỆN =====================
DENSITY_THRESHOLD_LOW=5            # Ngưỡng "Thưa" (xe)
DENSITY_THRESHOLD_MEDIUM=15        # Ngưỡng "Đông" (xe)

# ===================== VISION: VẠCH DỪNG (STOP-LINE) =====================
VISION_CANNY_LOW=30                # Canny: ngưỡng thấp
VISION_CANNY_HIGH=30               # Canny: ngưỡng cao
VISION_HOUGH_THRESHOLD=100         # Hough: ngưỡng tích luỹ
VISION_MIN_LINE_LEN_FACTOR=0.25    # Tỉ lệ min line length (0.0–1.0) theo ảnh
VISION_MAX_GAP_FACTOR=0.02         # Tỉ lệ max gap (0.0–1.0) theo ảnh
VISION_MIN_LINE_LEN_MIN_PX=60      # Min line length tuyệt đối (px)
VISION_MAX_GAP_MIN_PX=10           # Max gap tuyệt đối (px)
VISION_ANGLE_MAX_DEG=10            # Góc lệch tối đa so với ngang (độ)
VISION_CENTER_BIAS_RATIO=0.35      # Ưu tiên vùng trung tâm (0.0–1.0)
VISION_BOTTOM_MIN_Y_RATIO=0.6      # Chỉ xét từ 60% chiều cao trở xuống (0.0–1.0)

# ===================== LINE B (VẠCH PHỤ) =====================
LINE_B_OFFSET_PX=128                # Khoảng cách từ stopLine lên lineB (px)
LINE_B_STROKE_WIDTH=2              # Độ dày lineB (px)
STOP_LINE_STROKE_WIDTH=2           # Độ dày stopLine (px)

# ===================== VISION: ROI (MẶT ĐƯỜNG) =====================
# Các tham số cho phương pháp Seed màu đáy + Mahalanobis + refine biên
# Nếu bạn dùng Cell B trong detec-test.ipynb, các giá trị sau là điểm khởi đầu tốt.
ROI_PROC_WIDTH=900                 # Resize theo chiều rộng để xử lý nhanh (px)
ROI_BOTTOM_START_RATIO=0.60        # Bắt dải học màu từ 60%H xuống đáy
ROI_MD2_THRESH=-1                  # Ngưỡng d^2 Mahalanobis (<0: tự động)
ROI_MD2_AUTO_PERCENTILE=90         # Phân vị cho ngưỡng tự động (ví dụ: 85–92)
ROI_MIN_AREA_RATIO=0.002           # Tỉ lệ diện tích tối thiểu component giữ lại
ROI_MORPH_CLOSE_K=21               # Kernel CLOSE để lấp vùng xe che (px)
ROI_MORPH_OPEN_K=7                 # Kernel OPEN để bỏ nhiễu nhỏ (px)
ROI_ERODE_K=3                      # Erode nhẹ để viền gọn (px)
ROI_YCUT_RATIO=0.40                # Chỉ fit biên từ 40%H trở xuống
ROI_BIN_COUNT=45                   # Số dải y khi trích profile biên
ROI_SIDE_LEFT_PCTL=10              # Phân vị lấy biên trái theo x trong mỗi dải
ROI_SIDE_RIGHT_PCTL=90             # Phân vị lấy biên phải theo x trong mỗi dải
ROI_TOP_MIN_RATIO=0.42             # Giới hạn dưới của y_top (theo H)
ROI_TOP_MAX_RATIO=0.55             # Giới hạn trên của y_top (theo H)
ROI_TOP_FROM_MASK_PCTL=12          # Phân vị lấy y_top từ mask nếu có

# ===================== OBJECT TRACKING =====================
TRACKER_IOU_THRESHOLD=0.3          # Ngưỡng IoU để match tracks (0.0–1.0)
TRACKER_MAX_AGE=30                 # Số frames giữ track lost (1s @ 30fps)
TRACKER_MIN_HITS=3                 # Số hits tối thiểu để confirm track

# ===================== ROI STATE TRACKING =====================
ROI_STATE_CLEANUP_TIMEOUT=120      # Cleanup tracks cũ sau 120s (2 phút)

# ===================== STOPLINE CROSSING =====================
STOPLINE_CROSSING_THRESHOLD=10     # Khoảng cách threshold (px) để detect crossing
STOPLINE_DETECTION_RANGE=20        # Khoảng cách tối đa từ stopline để detect (px)
STOPLINE_CROSSING_TIMEOUT=30       # Cleanup tracks sau 30s
