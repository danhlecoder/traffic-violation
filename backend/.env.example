# =====================================================================
# BACKEND .ENV EXAMPLE - TEMPLATE CHO CẤU HÌNH
# =====================================================================
# Copy file này thành .env và điều chỉnh các tham số phù hợp
# =====================================================================

# ===================== STREAM CONFIG =====================
# FPS mặc định cho stream (càng cao càng mượt nhưng tốn tài nguyên)
STREAM_DEFAULT_FPS=60

# Chất lượng JPEG (0-100, càng cao càng đẹp nhưng tốn bandwidth)
STREAM_DEFAULT_QUALITY=95

# Timeout reconnect khi mất kết nối RTSP (giây)
STREAM_RECONNECT_TIMEOUT=30

# Skip frames để tăng tốc (0 = không skip)
STREAM_SKIP_FRAMES=0

# Resize width trước khi detect (0 = giữ nguyên)
STREAM_DETECTION_WIDTH=0

# ===================== HIỂN THỊ DETECTION =====================
# Độ dày khung bounding box (pixel)
BBOX_THICKNESS=1

# Kích thước font chữ
FONT_SCALE=0.5

# Độ dày font chữ
FONT_THICKNESS=1

# ===================== MẬT ĐỘ PHƯƠNG TIỆN =====================
# Ngưỡng mật độ thấp (số xe)
DENSITY_THRESHOLD_LOW=5

# Ngưỡng mật độ trung bình (số xe)
DENSITY_THRESHOLD_MEDIUM=15

# ===================== OBJECT TRACKING =====================
# Số lần detect tối thiểu trước khi xác nhận là object
TRACKER_MIN_HITS=1

# Số frame tối đa không detect được trước khi xóa track
TRACKER_MAX_AGE=30

# Ngưỡng IOU để match detections (0.0-1.0)
TRACKER_IOU_THRESHOLD=0.3

# ===================== STOPLINE CROSSING =====================
# Ngưỡng khoảng cách để xác định crossing (pixel)
STOPLINE_CROSSING_THRESHOLD=10

# Phạm vi detect quanh stopline (pixel)
STOPLINE_DETECTION_RANGE=50

# Timeout giữa các lần crossing của cùng 1 xe (giây)
STOPLINE_CROSSING_TIMEOUT=30

# ===================== ROI STATE TRACKING =====================
# Timeout cleanup tracks cũ (giây)
ROI_STATE_CLEANUP_TIMEOUT=120

# ===================== VISION - STOPLINE DETECTION =====================
# Canny edge detection - ngưỡng thấp
VISION_CANNY_LOW=30

# Canny edge detection - ngưỡng cao
VISION_CANNY_HIGH=30

# Hough transform threshold
VISION_HOUGH_THRESHOLD=100

# Min line length factor (tỷ lệ so với width)
VISION_MIN_LINE_LEN_FACTOR=0.25

# Max gap factor (tỷ lệ so với width)
VISION_MAX_GAP_FACTOR=0.02

# Min line length tối thiểu (pixel)
VISION_MIN_LINE_LEN_MIN_PX=60

# Max gap tối thiểu (pixel)
VISION_MAX_GAP_MIN_PX=10

# Góc tối đa cho line ngang (độ)
VISION_ANGLE_MAX_DEG=10

# Center bias ratio (ưu tiên line ở giữa)
VISION_CENTER_BIAS_RATIO=0.35

# Bottom min Y ratio (chỉ detect ở nửa dưới)
VISION_BOTTOM_MIN_Y_RATIO=0.6

# ===================== VISION - ROI DETECTION =====================
# Processing width (resize trước khi detect ROI)
ROI_PROC_WIDTH=900

# Bottom start ratio (bắt đầu detect từ đâu)
ROI_BOTTOM_START_RATIO=0.6

# Mahalanobis distance threshold (-1 = auto)
ROI_MD2_THRESH=-1

# Auto threshold percentile
ROI_MD2_AUTO_PERCENTILE=90

# Min area ratio (lọc vùng quá nhỏ)
ROI_MIN_AREA_RATIO=0.002

# Morphology close kernel size
ROI_MORPH_CLOSE_K=21

# Morphology open kernel size
ROI_MORPH_OPEN_K=7

# Erosion kernel size
ROI_ERODE_K=3

# Y cut ratio (cắt bớt phần trên)
ROI_YCUT_RATIO=0.40

# Histogram bin count
ROI_BIN_COUNT=45

# Side left percentile
ROI_SIDE_LEFT_PCTL=10

# Side right percentile
ROI_SIDE_RIGHT_PCTL=90

# Top min ratio
ROI_TOP_MIN_RATIO=0.42

# Top max ratio
ROI_TOP_MAX_RATIO=0.55

# Top from mask percentile
ROI_TOP_FROM_MASK_PCTL=12
