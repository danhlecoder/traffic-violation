# =====================================================
# BACKEND CONFIG - MULTI SERVER DEPLOYMENT
# =====================================================
# File này dùng khi deploy Backend trên Server 3
# Copy file này thành backend/.env và thay đổi IP theo hệ thống của bạn

# ===================== BACKEND CONFIG =====================
# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ⚠️ THAY ĐỔI IP Ở ĐÂY - External Services (IP của các server khác)
# ⚠️ Server 2 - YOLO Service
YOLO_API_URL=http://192.168.1.20:8001

# ⚠️ Server 1 - MongoDB Service  
MONGO_API_URL=http://192.168.1.10:8002

# ===================== STREAM CONFIG =====================
STREAM_DEFAULT_FPS=60
STREAM_DEFAULT_QUALITY=95
STREAM_RECONNECT_TIMEOUT=30
STREAM_SKIP_FRAMES=0
STREAM_DETECTION_WIDTH=0

# ===================== HIỂN THỊ DETECTION =====================
BBOX_THICKNESS=1
FONT_SCALE=0.5
DENSITY_THRESHOLD_LOW=5
DENSITY_THRESHOLD_MEDIUM=15

# ===================== OBJECT TRACKING =====================
TRACKER_MIN_HITS=1
TRACKER_MAX_AGE=30
TRACKER_IOU_THRESHOLD=0.3

# ===================== STOPLINE CROSSING =====================
STOPLINE_CROSSING_THRESHOLD=10
STOPLINE_DETECTION_RANGE=50
STOPLINE_CROSSING_TIMEOUT=30

# ===================== ROI STATE TRACKING =====================
ROI_STATE_CLEANUP_TIMEOUT=120

# ===================== VISION - STOPLINE DETECTION =====================
VISION_CANNY_LOW=30
VISION_CANNY_HIGH=30
VISION_HOUGH_THRESHOLD=100
VISION_MIN_LINE_LEN_FACTOR=0.25
VISION_MAX_GAP_FACTOR=0.02

# ===================== VISION - ROI DETECTION =====================
ROI_MORPH_CLOSE_K=21
ROI_MORPH_OPEN_K=7
ROI_ERODE_K=3
ROI_YCUT_RATIO=0.40
ROI_BIN_COUNT=45
ROI_SIDE_LEFT_PCTL=10
ROI_SIDE_RIGHT_PCTL=90
ROI_TOP_MIN_RATIO=0.42
ROI_TOP_MAX_RATIO=0.55
ROI_TOP_FROM_MASK_PCTL=12

# ===================== YOLO DETECTION =====================
YOLO_CONFIDENCE=0.4
YOLO_IOU_THRESHOLD=0.45
YOLO_MAX_DETECTIONS=100
