# =====================================================================
# BACKEND .ENV - CẤU HÌNH THAM SỐ ĐIỀU CHỈNH HỆ THỐNG
# =====================================================================
# Các cấu hình tĩnh (địa chỉ API, logging, etc.) nằm trong server.yaml
# File này chỉ chứa các tham số có thể thay đổi để tối ưu hệ thống
# =====================================================================

# ===================== CẤU HÌNH STREAMING VIDEO =====================

# STREAM_DEFAULT_FPS: Số khung hình trên giây (FPS) mục tiêu cho video stream
STREAM_DEFAULT_FPS=60

# STREAM_DEFAULT_QUALITY: Chất lượng nén JPEG (10-100)
STREAM_DEFAULT_QUALITY=95

# STREAM_RECONNECT_TIMEOUT: Thời gian chờ reconnect khi mất kết nối RTSP (giây)
# - Nếu stream bị disconnect, hệ thống sẽ đợi N giây trước khi thử kết nối lại
STREAM_RECONNECT_TIMEOUT=30

# STREAM_SKIP_FRAMES: Số frame bỏ qua giữa các lần đọc (để giảm lag)
STREAM_SKIP_FRAMES=0

# STREAM_DETECTION_WIDTH: Độ rộng resize frame trước khi detect (pixels)
STREAM_DETECTION_WIDTH=640

# ===================== CACHE CẤU HÌNH CAMERA =====================

# MONGO_CAMERA_CACHE_TTL: Thời gian cache (giây) cho thông tin camera từ Mongo service
# - Giảm call HTTP liên tục, tránh lag khi stream realtime
MONGO_CAMERA_CACHE_TTL=2.0

# ===================== HIỂN THỊ BOUNDING BOX VÀ TEXT =====================

# BBOX_THICKNESS: Độ dày của khung bounding box (pixels)
BBOX_THICKNESS=1

# FONT_SCALE: Kích thước chữ hiển thị trên bbox
FONT_SCALE=0.5

# FONT_THICKNESS: Độ dày nét chữ
# - 1: Mỏng
# - 2-3: Dày, đậm hơn
FONT_THICKNESS=1

# ===================== NGƯỠNG MẬT ĐỘ PHƯƠNG TIỆN =====================

# DENSITY_THRESHOLD_LOW: Ngưỡng phân loại mật độ "Thấp" (số xe)
DENSITY_THRESHOLD_LOW=5
# DENSITY_THRESHOLD_MEDIUM: Ngưỡng phân loại mật độ "Trung bình"
DENSITY_THRESHOLD_MEDIUM=15

# ===================== CẤU HÌNH OBJECT TRACKING (SORT/DeepSORT) =====================

# TRACKER_MIN_HITS: Số lần phát hiện tối thiểu để xác nhận track
TRACKER_MIN_HITS=1

# TRACKER_MAX_AGE: Số frame tối đa giữ track khi mất phát hiện
# - 30-50: Track sẽ bị xóa nếu không detect lại trong N frames
# - Giá trị cao: Giữ track lâu hơn khi đối tượng bị che khuất tạm thời
TRACKER_MAX_AGE=70

# TRACKER_IOU_THRESHOLD: Ngưỡng IoU (Intersection over Union) để match bbox
# - 0.1-0.3: Dễ dàng match (dùng khi đối tượng di chuyển nhanh)
# - 0.4-0.6: Nghiêm ngặt hơn (dùng khi đối tượng di chuyển chậm)
# - IoU = Diện tích giao / Diện tích hợp của 2 bounding boxes
TRACKER_IOU_THRESHOLD=0.25
TRAJECTORY_ACTIVE_SECONDS=0.6

# Khi không có phương tiện trong một khoảng thời gian, reset lại track_id về 1
# (tính theo giây, dựa trên FPS stream)
TRACKER_RESET_IDLE_SECONDS=1.0
TRACKER_RESET_ON_IDLE=true

# TRACKER_CENTER_DISTANCE_PX: Ngưỡng khoảng cách tâm (px) để giữ track khi IoU thấp
# - Giá trị cao hơn giúp track_id bám dính khi bbox thay đổi mạnh
TRACKER_CENTER_DISTANCE_PX=140

# TRACKER_INIT_GRACE_FRAMES: Số frame cho phép track mới bị miss trước khi bị loại
TRACKER_INIT_GRACE_FRAMES=3
# ===================== PHÁT HIỆN VƯỢT VẠCH DỪNG (STOPLINE) =====================

# STOPLINE_DETECTION_RANGE: Phạm vi phát hiện xung quanh vạch dừng (pixels)
# - Hệ thống chỉ theo dõi xe trong khoảng [stopline - range, stopline + range]
# - Giúp giảm tải, chỉ track xe gần vạch dừng
STOPLINE_DETECTION_RANGE=160
# STOPLINE_CROSSING_TIMEOUT: Thời gian timeout để reset trạng thái crossing (giây)
# - Sau N giây không detect lại xe, sẽ xóa trạng thái crossing của track ID đó
STOPLINE_CROSSING_TIMEOUT=30

# ===================== COMPUTER VISION - TỰ ĐỘNG PHÁT HIỆN VẠCH DỪNG =====================
# Các tham số cho thuật toán Canny Edge Detection + Hough Line Transform

# VISION_CANNY_LOW: Ngưỡng thấp của Canny Edge Detection
# - Giá trị thấp (20-50): Phát hiện nhiều edge hơn (nhiễu hơn)
VISION_CANNY_LOW=30

# VISION_CANNY_HIGH: Ngưỡng cao của Canny Edge Detection
# - Thường = CANNY_LOW hoặc gấp 2-3 lần
VISION_CANNY_HIGH=30

# VISION_HOUGH_THRESHOLD: Ngưỡng vote trong Hough Transform
# - Giá trị cao: Chỉ chọn các line có nhiều điểm vote (chính xác hơn)
# - Giá trị thấp: Phát hiện nhiều line hơn (nhiễu hơn)
VISION_HOUGH_THRESHOLD=100

# VISION_MIN_LINE_LEN_FACTOR: Hệ số tính độ dài tối thiểu của line (0-1)
# - min_line_len = image_width * factor
# - 0.25 = line phải dài ít nhất 25% chiều rộng ảnh
VISION_MIN_LINE_LEN_FACTOR=0.25

# VISION_MAX_GAP_FACTOR: Hệ số khoảng cách tối đa giữa các đoạn line (0-1)
# - max_gap = image_width * factor
# - Cho phép nối các đoạn line gần nhau thành 1 line
VISION_MAX_GAP_FACTOR=0.02

# VISION_MIN_LINE_LEN_MIN_PX: Độ dài tối thiểu tuyệt đối của line (pixels)
# - Đảm bảo line không quá ngắn ngay cả với ảnh nhỏ
VISION_MIN_LINE_LEN_MIN_PX=60

# VISION_MAX_GAP_MIN_PX: Khoảng cách tối thiểu tuyệt đối (pixels)
VISION_MAX_GAP_MIN_PX=10

# VISION_ANGLE_MAX_DEG: Góc tối đa cho line nằm ngang (độ)
# - Vạch dừng thường nằm ngang, angle gần 0 hoặc 180 độ
# - 10 = chấp nhận line có góc nghiêng <= 10 độ so với ngang
VISION_ANGLE_MAX_DEG=10

# VISION_CENTER_BIAS_RATIO: Tỷ lệ ưu tiên line gần tâm ảnh (0-1)
# - 0.35 = line càng gần tâm càng được ưu tiên
VISION_CENTER_BIAS_RATIO=0.35

# VISION_BOTTOM_MIN_Y_RATIO: Vị trí tối thiểu của line trên ảnh (0-1)
# - 0.6 = chỉ tìm line ở 60% phía dưới ảnh (vạch dừng thường ở dưới)
VISION_BOTTOM_MIN_Y_RATIO=0.6

# ===================== THEO DÕI QUỸ ĐẠO DI CHUYỂN (TRAJECTORY) =====================

# TRAJECTORY_ENABLED: Bật/tắt tính năng theo dõi quỹ đạo
# - true: Vẽ đường đi của xe, hiển thị tốc độ
# - false: Tắt để tăng performance
TRAJECTORY_ENABLED=true

# TRAJECTORY_MAX_POINTS: Số điểm tối đa lưu trong quỹ đạo
# - 30 điểm = lưu 30 vị trí gần nhất của mỗi xe
# - Giá trị cao: Quỹ đạo dài hơn nhưng tốn bộ nhớ
TRAJECTORY_MAX_POINTS=30

# TRAJECTORY_CLEANUP_TIMEOUT: Thời gian cleanup quỹ đạo không còn dùng (giây)
# - Sau N giây không detect lại track, xóa quỹ đạo của track đó
TRAJECTORY_CLEANUP_TIMEOUT=30

# TRAJECTORY_LINE_THICKNESS: Độ dày đường quỹ đạo (pixels)
TRAJECTORY_LINE_THICKNESS=2

# TRAJECTORY_POINT_RADIUS: Bán kính điểm đánh dấu trên quỹ đạo (pixels)
TRAJECTORY_POINT_RADIUS=3

# TRAJECTORY_ARROW_LENGTH: Độ dài mũi tên chỉ hướng di chuyển (pixels)
TRAJECTORY_ARROW_LENGTH=30

# TRAJECTORY_SHOW_SPEED: Hiển thị tốc độ trên quỹ đạo
# - true: Hiển thị tốc độ (km/h hoặc px/s)
# - false: Không hiển thị
TRAJECTORY_SHOW_SPEED=true

# TRAJECTORY_SHOW_TRACK_ID: Hiển thị Track ID trên quỹ đạo
TRAJECTORY_SHOW_TRACK_ID=true

# TRAJECTORY_FADE_EFFECT: Hiệu ứng mờ dần cho quỹ đạo cũ
# - true: Điểm cũ mờ dần, điểm mới đậm hơn (đẹp hơn)
# - false: Tất cả điểm cùng độ đậm
TRAJECTORY_FADE_EFFECT=true

# ----- HIỆU CHỈNH TỐC ĐỘ (Speed Calibration) -----
# Chuyển đổi từ pixels/giây sang km/h

# TRAJECTORY_SPEED_IN_KMH: Bật/tắt chuyển đổi sang km/h
# - true: Hiển thị tốc độ km/h (cần calibration)
# - false: Hiển thị px/s (không cần calibration)
TRAJECTORY_SPEED_IN_KMH=true

# PIXELS_PER_METER: 1 mét thực tế tương ứng bao nhiêu pixel trên vidéo
# - Ví dụ: 32 nghĩa là 32px ≈ 1m
PIXELS_PER_METER=32

# TRAJECTORY_PIXELS_BETWEEN_LINES: Khoảng cách pixel giữa lineStop và lineB
# - Dùng để đo vận tốc: distance_px / PIXELS_PER_METER
# - Ví dụ: 160px tương ứng ~5 mét với PIXELS_PER_METER=32
TRAJECTORY_PIXELS_BETWEEN_LINES=160
