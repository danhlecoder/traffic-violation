# =====================================================
# FRONTEND CONFIG - Environment Variables
# =====================================================
# Copy file này thành .env.production.local khi deploy

# ⚠️ Backend API URL - Đổi IP theo server Backend của bạn
# Single Server: http://localhost:8000
# Multi Server: http://[IP_SERVER_BACKEND]:8000
VITE_API_BASE_URL=http://192.168.1.43:8000

# Development
# VITE_API_BASE_URL=http://localhost:8000

# Production với HTTPS
# VITE_API_BASE_URL=https://your-domain.com
