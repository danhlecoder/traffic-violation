# =====================================================
# FRONTEND CONFIG - MULTI SERVER DEPLOYMENT
# =====================================================
# File này dùng khi deploy Frontend trên Server 4
# Copy file này thành frontend/.env.production.local và thay đổi IP

# ⚠️ THAY ĐỔI IP Ở ĐÂY - Backend API URL (IP của Server 3)
VITE_API_BASE_URL=http://192.168.1.30:8000

# Nếu dùng HTTPS, đổi thành:
# VITE_API_BASE_URL=https://192.168.1.30:8000
